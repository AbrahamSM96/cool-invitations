# Neon connection string (Dashboard → Connect → pooled connection)
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Admin login. Generate both with: bun run admin:credentials
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
# Two-factor login (authenticator app). Generate with: bun run admin:2fa
ADMIN_TOTP_SECRET=
