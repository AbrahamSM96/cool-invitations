{
  "name": "cool-invitations",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint --type-aware . && bun run typecheck",
    "lint:fix": "oxlint --type-aware --fix .",
    "typecheck": "next typegen && ./node_modules/typescript-7/bin/tsc --noEmit",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "bun run lint:fix && bun run format && bun run typecheck",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun scripts/seed.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "drizzle-orm": "^0.45.4",
    "nanoid": "^6.0.2",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint-plugin-jsdoc": "^65.4.2",
    "eslint-plugin-sort-destructure-keys": "^3.0.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-7": "npm:typescript@7"
  },
  "packageManager": "bun@1.3.14",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
